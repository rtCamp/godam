{
	"name": "rtcamp/godam",
	"type": "wordpress-plugin",
	"require-dev": {
		"wp-coding-standards/wpcs": "^3.1",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"automattic/vipwpcs": "^3.0",
		"phpunit/phpunit": "^9.6",
		"wp-phpunit/wp-phpunit": "^6.2",
		"yoast/phpunit-polyfills": "^1.0",
		"wp-cli/i18n-command": "^v2.6",
		"squizlabs/php_codesniffer": "^3.13"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"pre-commit": [
		"npm run lint:staged"
		],
		"phpunit": "phpunit",
		"pot": "bin/make-pot.sh ./languages/godam.pot"
	},
	"scripts-descriptions": {
		"pot": "Regenerate languages/godam.pot. Needs a fresh assets/build first: WordPress resolves JS translations by md5 of the enqueued script path, so every JS string needs a reference to the built file it ships in. See the comment block in bin/make-pot.sh."
	},
	"require": {
		"woocommerce/action-scheduler": "^3.9"
	}
}
